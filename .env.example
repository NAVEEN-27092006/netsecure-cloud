# Copy these values into your shell or a local .env file managed by your deployment platform.
# Generate a long random value for NETSECURE_SESSION_SECRET before production deployment.
NETSECURE_SESSION_SECRET=replace-with-a-long-random-secret
NETSECURE_DATABASE_PATH=data/netsecure.db
NETSECURE_SESSION_HOURS=12

# Leave false for a public deployment. Turn on only for a trusted local lab.
NETSECURE_ALLOW_PRIVATE_TARGETS=false

# Set true when the application is behind HTTPS in production.
NETSECURE_COOKIE_SECURE=false
NETSECURE_ENVIRONMENT=development
